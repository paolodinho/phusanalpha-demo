/* Cam nhan khach hang: tu dong chay. Sua cau hinh Splide TRUOC khi Bricks khoi tao (script chay dong bo trong footer).
   Chi co 3 cam nhan + hien 3 the thi khong co gi de truot -> hien 2 the moi lan cho co chuyen dong; khi co >3 cam nhan se tu dung 3 the. */
(function () {
  var el = document.getElementById('brxe-sozdxb');
  if (!el || !el.dataset.splide) return;
  try {
    var o = JSON.parse(el.dataset.splide);
    var n = el.querySelectorAll('.splide__slide:not(.splide__slide--clone)').length;
    o.type = 'loop'; o.autoplay = true; o.interval = 4500; o.pauseOnHover = true; o.pauseOnFocus = true; o.speed = 700;
    o.perMove = 1; o.arrows = true; o.pagination = n > 1;
    if (n <= 3) { o.perPage = 2; if (o.breakpoints && o.breakpoints['1279']) o.breakpoints['1279'].perPage = '2'; }
    el.dataset.splide = JSON.stringify(o);
  } catch (e) { /* giu nguyen cau hinh cu neu JSON loi */ }
})();

/* Chong chu mo coi (quy tac wording-orphans muc 8) */
/* Chống chữ mồ côi (1 từ trên 1 dòng) - dán vào JS của mọi site.
   Nối bằng NBSP từ cuối cùng với từ liền trước trong mọi tiêu đề, đoạn, mục danh sách, nút, chú thích.
   Đi kèm CSS: h1..h6,.title{text-wrap:balance} p,li,figcaption{text-wrap:pretty} */
(function () {
  var SEL = 'h1,h2,h3,h4,h5,h6,p,li,figcaption,blockquote,dd,dt,.btn,.kicker,[data-nowrap-tail],#brx-footer a,#brx-footer .brxe-text-basic,#brx-footer .brxe-text,.brxe-heading,.brxe-post-title,.brxe-button,.alpha-az-btn';
  function glue(root) {
    (root || document).querySelectorAll(SEL).forEach(function (el) {
      if (el.dataset.orphanDone) return;
      var w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null), last = null, n;
      while ((n = w.nextNode())) if (n.nodeValue.trim()) last = n;
      if (!last) return;
      var t = last.nodeValue.replace(/\s+$/, ''), m = t.match(/^([\s\S]*\S)\s+(\S+)$/);
      if (m && /\S\s+\S/.test(t)) last.nodeValue = m[1] + ' ' + m[2] + last.nodeValue.slice(t.length);
      else if (last.previousSibling === null && last.parentNode !== el) return; /* từ cuối nằm riêng trong thẻ con: bỏ qua */
      el.dataset.orphanDone = '1';
    });
  }
  if (document.readyState !== 'loading') glue(); else document.addEventListener('DOMContentLoaded', function () { glue(); });
  window.icdGlueOrphans = glue;
})();


