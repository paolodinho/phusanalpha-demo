/* Gợi ý "vuốt ngang" trên mobile cho bảng rộng hơn khung */
(function(){var mq=window.matchMedia('(max-width:767px)');function run(){document.querySelectorAll('main table').forEach(function(t){var prev=t.previousElementSibling;var has=prev&&prev.classList&&prev.classList.contains('alpha-tscroll-hint');var wide=mq.matches&&t.scrollWidth>t.clientWidth+4;if(wide&&!has){var h=document.createElement('div');h.className='alpha-tscroll-hint';h.textContent='Vuốt ngang để xem đủ các cột';t.parentNode.insertBefore(h,t)}else if(!wide&&has){prev.remove()}})}
window.addEventListener('load',function(){setTimeout(run,600);setTimeout(run,2000)});window.addEventListener('resize',run)})();

/* Nút "Đặt lịch khám" mở thẳng form đặt lịch (popup 1450 của header) thay vì chuyển sang trang Liên hệ */
(function(){document.addEventListener('click',function(e){var a=e.target.closest&&e.target.closest('a');if(!a)return;if(/\/lien-he\/?$/.test(location.pathname))return;var href=a.getAttribute('href')||'';var txt=(a.textContent||'').trim();if(!/^đặt lịch/i.test(txt)&&!a.classList.contains('alpha-action'))return;if(!/\/lien-he\/?(#.*)?$/.test(href.replace(location.origin,''))&&href!=='#')return;var t=document.querySelector('#brxe-agppdo');if(!t)return;e.preventDefault();t.dispatchEvent(new MouseEvent('click',{bubbles:true,cancelable:true,view:window}))},true)})();
